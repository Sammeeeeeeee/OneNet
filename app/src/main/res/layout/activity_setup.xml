<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_background">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <!-- One UI's expanded app bar: a large title in the top third, content below in thumb reach. -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:gravity="bottom"
                android:minHeight="240dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/SetupLargeTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/setup_tagline"
                    android:textAppearance="@style/SetupRowSummary" />
            </LinearLayout>

            <!-- The tile as it looks in the quick panel now, 2× wide. -->
            <FrameLayout
                style="@style/SetupCard"
                android:background="@drawable/preview_backdrop"
                android:paddingHorizontal="20dp"
                android:paddingVertical="28dp">

                <LinearLayout
                    android:id="@+id/preview_tile"
                    android:layout_width="wrap_content"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:background="@drawable/preview_tile"
                    android:gravity="center_vertical"
                    android:minWidth="236dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="24dp">

                    <FrameLayout
                        android:id="@+id/preview_circle"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/preview_circle">

                        <ImageView
                            android:id="@+id/preview_icon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/preview_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="150dp"
                            android:maxLines="1"
                            android:textAppearance="@style/PreviewTitle" />

                        <TextView
                            android:id="@+id/preview_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="150dp"
                            android:maxLines="1"
                            android:textAppearance="@style/PreviewSubtitle" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                style="@style/SetupFootnote"
                android:layout_marginTop="-4dp"
                android:text="@string/setup_preview_note" />

            <LinearLayout style="@style/SetupCard">

                <LinearLayout style="@style/SetupRow">

                    <LinearLayout style="@style/SetupRowText">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_shizuku"
                            android:textAppearance="@style/SetupRowTitle" />

                        <TextView
                            android:id="@+id/shizuku_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/SetupRowSummary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/shizuku_action"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SetupSectionTitle"
                android:text="@string/setup_quick_panel" />

            <LinearLayout
                style="@style/SetupCard"
                android:divider="@drawable/setup_divider"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/add_tile"
                    style="@style/SetupRow">

                    <LinearLayout style="@style/SetupRowText">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_add_tile"
                            android:textAppearance="@style/SetupRowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_add_tile_summary"
                            android:textAppearance="@style/SetupRowSummary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/name_as_title_row"
                    style="@style/SetupRow">

                    <LinearLayout style="@style/SetupRowText">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_name_as_title"
                            android:textAppearance="@style/SetupRowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_name_as_title_summary"
                            android:textAppearance="@style/SetupRowSummary" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/name_as_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/setup_name_as_title" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SetupSectionTitle"
                android:text="@string/setup_how_it_works" />

            <LinearLayout
                style="@style/SetupCard"
                android:divider="@drawable/setup_divider"
                android:showDividers="middle">

                <LinearLayout
                    style="@style/SetupRow"
                    android:background="@null">

                    <LinearLayout style="@style/SetupRowText">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_tap"
                            android:textAppearance="@style/SetupRowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_tap_summary"
                            android:textAppearance="@style/SetupRowSummary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/SetupRow"
                    android:background="@null">

                    <LinearLayout style="@style/SetupRowText">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_hold"
                            android:textAppearance="@style/SetupRowTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setup_hold_summary"
                            android:textAppearance="@style/SetupRowSummary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/about"
                style="@style/SetupFootnote"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingVertical="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- The app bar collapsed: its title fades in once the large one scrolls away. -->
    <FrameLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/setup_background">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:text="@string/app_name"
            android:textAppearance="@style/SetupToolbarTitle" />
    </FrameLayout>
</FrameLayout>
