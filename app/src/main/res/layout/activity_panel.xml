<?xml version="1.0" encoding="utf-8"?>
<!-- Proportions traced from One UI 9's quick panel detail view (Bluetooth, Modes). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.192" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/internet"
            android:textAppearance="@style/PanelTitle" />

        <Space
            android:layout_width="0dp"
            android:layout_height="30dp" />

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="0.552"
            android:background="@drawable/panel_card"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/mobile_row"
                style="@style/PanelRow">

                <ImageView
                    android:id="@+id/mobile_icon"
                    style="@style/PanelRowIcon"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mobile_title"
                        style="@style/PanelRowTitle" />

                    <TextView
                        android:id="@+id/mobile_summary"
                        style="@style/PanelRowSummary" />
                </LinearLayout>

                <View style="@style/PanelVerticalDivider" />

                <Switch
                    android:id="@+id/mobile_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/mobile_data" />
            </LinearLayout>

            <LinearLayout style="@style/PanelRow">

                <TextView
                    style="@style/PanelRowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/wifi" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:indeterminateTint="@color/panel_text_secondary"
                    android:visibility="invisible" />

                <Switch
                    android:id="@+id/wifi_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/wifi" />
            </LinearLayout>

            <View style="@style/PanelDivider" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadingEdgeLength="24dp"
                android:overScrollMode="ifContentScrolls"
                android:requiresFadingEdge="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="26dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="6dp"
                        android:textAppearance="@style/PanelSectionText" />

                    <LinearLayout
                        android:id="@+id/shizuku_banner"
                        style="@style/PanelRow"
                        android:background="@null"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/shizuku_text"
                            style="@style/PanelRowSummary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:maxLines="3" />

                        <TextView
                            android:id="@+id/shizuku_button"
                            style="@style/PanelTextButton"
                            android:layout_width="wrap_content"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/connected_row"
                        style="@style/PanelRow">

                        <ImageView
                            android:id="@+id/connected_icon"
                            style="@style/PanelRowIcon"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/connected_title"
                                style="@style/PanelRowTitle" />

                            <TextView
                                android:id="@+id/connected_summary"
                                style="@style/PanelRowSummary" />
                        </LinearLayout>

                        <View style="@style/PanelVerticalDivider" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/wifi_settings"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/panel_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/network_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/airplane_button"
                        style="@style/PanelTextButton"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="26dp"
                        android:text="@string/turn_off_airplane_mode"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/details"
                    style="@style/PanelTextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/details" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="@color/panel_divider" />

                <TextView
                    android:id="@+id/done"
                    style="@style/PanelTextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/done" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.166" />
    </LinearLayout>
</FrameLayout>
