<?xml version="1.0" encoding="utf-8"?>
<!-- One Wi-Fi network. The top row (connected, or being joined) is drawn in the accent colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PanelRow">

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/lock"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="bottom|end"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock"
            android:tint="?android:attr/textColorPrimary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/PanelRowTitle" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/PanelSummary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="16dp"
        android:indeterminateTint="?android:attr/colorAccent"
        android:visibility="gone" />

    <View
        android:id="@+id/details_divider"
        style="@style/PanelVerticalDivider"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/details"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/wifi_settings"
        android:src="@drawable/ic_settings"
        android:tint="?android:attr/textColorSecondary"
        android:visibility="gone" />
</LinearLayout>
